<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ergänzt die von Xcode erzeugte Info.plist. Audio im Hintergrund: damit der Puls-Bildschirm
	     bei gesperrtem iPhone weiter auf die Lautstärketasten hört. -->
	<!-- Schreibmaschinenschrift für Messwerte (Courier Prime). Überschriften nutzen Helvetica, die ist im iPhone schon drin. -->
	<key>UIAppFonts</key>
	<array>
		<string>CourierPrime-Regular.ttf</string>
		<string>CourierPrime-Bold.ttf</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Für die Pulsmessung: Kamera und Blitz erkennen am Finger, wie das Blut im Takt des Herzschlags pulsiert. Es werden keine Bilder gespeichert.</string>
	<key>NSMotionUsageDescription</key>
	<string>Damit die Pulsmessung erkennt, wenn das iPhone bewegt wird, und dann neu startet.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
