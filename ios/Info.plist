<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ergänzt die von Xcode erzeugte Info.plist. Audio im Hintergrund: damit der Puls-Bildschirm
	     bei gesperrtem iPhone weiter auf die Lautstärketasten hört. -->
	<!-- Eigene Schriften: Doto (Punktmatrix für Zahlen und Namen), IBM Plex Mono für alles andere -->
	<key>UIAppFonts</key>
	<array>
		<string>DotoLab-ExtraBold.ttf</string>
		<string>IBMPlexMono-Regular.ttf</string>
		<string>IBMPlexMono-Medium.ttf</string>
		<string>IBMPlexMono-SemiBold.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
